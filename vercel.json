{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/api/sync/auto",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/bcp/auto-capture",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/sync/retry-check",
      "schedule": "*/5 * * * *"
    }
  ],
  "functions": {
    "api/**/*.py": {
      "maxDuration": 300
    }
  }
}
